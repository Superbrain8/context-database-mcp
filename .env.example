# Copy per MCP client. These are read by the server process at startup;
# they are deliberately NOT tool arguments, so the model cannot reach another
# client's memory even if it asks to.

# Which client this process serves. Free-form, but keep it stable --
# changing it orphans everything previously saved under the old value.
CTXDB_CLIENT_ID=claude-code

# Second isolation axis: the project this process is scoped to. Use a plain
# name, not a filesystem path -- Git Bash / MSYS rewrites POSIX-looking values
# when launching a native .exe, which would silently split one project's
# memories across two namespaces depending on which shell started the server.
# It also reads better in the "from project X" label on cross-project hits.
CTXDB_NAMESPACE=context-database-mcp

CTXDB_DATABASE_URL=postgres://ctx:ctx@127.0.0.1:5433/ctxdb
CTXDB_EMBED_URL=http://127.0.0.1:8085
CTXDB_EMBED_MODEL=BAAI/bge-m3

# Cosine-distance cutoff for the dense ranker. Without a cap, vector search
# always returns its k nearest rows however unrelated they are, so a query with
# no real answer still looks like a hit. Measured with bge-m3: a paraphrase of a
# stored note sits near 0.33, an unrelated note near 0.66. Raise it to recall
# more loosely, lower it for stricter matching.
CTXDB_MAX_DISTANCE=0.55

# tracing filter; all logs go to stderr (stdout is the MCP transport)
CTXDB_LOG=info
